{
  "name": "kps-intelligence",
  "private": true,
  "version": "0.1.0",
  "description": "KPS Intelligence — plateforme interne d'orchestration des demandes, prospects, équipes et missions de KPS Agency.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "node supabase/migrate.mjs",
    "db:gen-types": "node supabase/generate-types.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
