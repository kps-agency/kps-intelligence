# ============================================================
# KPS Intelligence — Variables d'environnement
# Copier ce fichier en .env (racine) et/ou .env par app, et
# renseigner les vraies valeurs. Ne jamais committer .env.
# ============================================================

# ---- Environnement ----
# NODE_ENV n'est volontairement pas défini ici : chaque outil (Next.js,
# Nest) le gère lui-même selon la commande lancée (dev/build/start) ; le
# forcer via .env casse le build de production de Next.js.
APP_ENV=development

# ---- App URLs ----
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PUBLIC_QUALIFICATION_URL=http://localhost:3000/qualification

# ---- Database (Supabase Postgres) ----
# Utiliser le Session Pooler (IPv4), onglet "Session pooler" dans
# Project Settings → Database → Connection string. La connexion directe
# (db.<ref>.supabase.co) est IPv6 uniquement et s'est révélée injoignable
# en pratique sur certains réseaux (ENETUNREACH) — le pooler est aussi
# l'option recommandée par Supabase pour ce cas.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# ---- Supabase ----
# Nouveau système de clés API Supabase (Project Settings → API Keys) :
# - SUPABASE_PUBLISHABLE_KEY : équivalent de l'ancienne "anon key", safe
#   côté client (uniquement pour Supabase Auth SDK dans apps/web).
# - SUPABASE_SECRET_KEY : équivalent de l'ancienne "service role key",
#   BYPASS RLS — serveur uniquement (apps/api), jamais côté frontend.
# - SUPABASE_JWKS_URL : endpoint JWKS utilisé par apps/api pour vérifier
#   la signature des JWT émis par Supabase Auth (clés asymétriques).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Exposées au navigateur par Next.js (préfixe NEXT_PUBLIC_ obligatoire).
# Mêmes valeurs que SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY ci-dessus —
# la publishable key est conçue pour être publique, jamais la secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Auth ----
# Secret applicatif générique (signature de cookies/tokens internes hors
# Supabase Auth, qui utilise SUPABASE_JWKS_URL ci-dessus). Générer avec
# `openssl rand -hex 32`.
JWT_SECRET=

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Email provider (Phase 11) ----
# Compte Gmail avec mot de passe d'application (myaccount.google.com/
# apppasswords, nécessite la validation en 2 étapes). SMTP pour l'envoi ;
# la réception (Phase 11) se fait par IMAP polling sur ce même compte —
# Gmail n'offre pas de webhook d'inbound simple pour un compte personnel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Même compte, protocole IMAP (réception) — IMAP_USER/IMAP_PASSWORD
# valent SMTP_USER/SMTP_PASSWORD pour Gmail, séparés ici pour rester
# valable si le provider d'envoi et de réception diffèrent un jour.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
EMAIL_POLL_INTERVAL_SECONDS=60

# ---- WhatsApp Business Cloud API (Meta) ----
# App Meta (developers.facebook.com) avec le produit WhatsApp. Le webhook
# à déclarer côté Meta est <URL publique HTTPS de l'API>/api/v1/webhooks/whatsapp
# (champ "messages"). Tant que ces valeurs sont vides, l'API démarre
# normalement mais refuse tout webhook WhatsApp et tout envoi.
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=
# Chaîne libre choisie par nous, recopiée à l'identique dans la config
# du webhook côté Meta (poignée de main d'abonnement).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret de l'app Meta (Paramètres > Général) : vérifie la signature
# X-Hub-Signature-256 de chaque webhook.
WHATSAPP_APP_SECRET=

# ---- Security ----
QUALIFICATION_LINK_DEFAULT_EXPIRY_DAYS=30
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- Observabilité ----
# Niveau des logs JSON structurés de apps/api (trace|debug|info|warn|error).
LOG_LEVEL=info

# ---- Tests d'intégration API (apps/api/test) ----
# Comptes du projet Supabase de DEV (jamais de production) : un SUPER_ADMIN et
# un VIEWER. Les tests créent puis suppriment leurs propres données.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_VIEWER_EMAIL=
E2E_VIEWER_PASSWORD=
