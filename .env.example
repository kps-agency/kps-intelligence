# ============================================================
# KPS Intelligence — Variables d'environnement
# Copier ce fichier en .env (racine) et/ou .env par app, et
# renseigner les vraies valeurs. Ne jamais committer .env.
# ============================================================

# ---- Environnement ----
NODE_ENV=development
APP_ENV=development

# ---- App URLs ----
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PUBLIC_QUALIFICATION_URL=http://localhost:3000/qualification

# ---- Database (Supabase Postgres) ----
# Connection string affiché dans Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kps_intelligence

# ---- Supabase ----
# Nouveau système de clés API Supabase (Project Settings → API Keys) :
# - SUPABASE_PUBLISHABLE_KEY : équivalent de l'ancienne "anon key", safe
#   côté client (uniquement pour Supabase Auth SDK dans apps/web).
# - SUPABASE_SECRET_KEY : équivalent de l'ancienne "service role key",
#   BYPASS RLS — serveur uniquement (apps/api), jamais côté frontend.
# - SUPABASE_JWKS_URL : endpoint JWKS utilisé par apps/api pour vérifier
#   la signature des JWT émis par Supabase Auth (clés asymétriques).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ---- Auth ----
JWT_SECRET=

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Email provider ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@kps.agency

# ---- WhatsApp Business Cloud API (Meta) ----
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Security ----
QUALIFICATION_LINK_DEFAULT_EXPIRY_DAYS=30
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
